<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to list every launchable app and every installed icon pack. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Lets "Uninstall" open the system uninstall confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Frosted and glass effects: sets the photo the user picks as the home wallpaper, so the
         launcher has the image to blur (apps cannot read a wallpaper set elsewhere). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <!-- The wallpaper chooser shows the latest photos when the user allows it (optional). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Canyon search shows matching contacts once the user allows it from the results (optional). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- "call ana" + Go places the call; asked the first time (otherwise the dialer opens). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- "Capture wallpaper": one frame of the screen with Android's screen capture (the user
         agrees each time), which Android runs as a short foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- "timer 5 min" and "alarm 7:30" hand the time to the clock app. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeLauncher">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity,NonResizeableActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER_APP" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/home_settings"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HomeLauncher.Settings"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".WallpaperActivity"
            android:exported="false"
            android:label="@string/choose_wallpaper"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HomeLauncher.Settings"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <!-- Notification badges: counts each app's notifications. -->
        <service
            android:name=".badges.BadgeService"
            android:exported="false"
            android:label="@string/badges"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Home screen gestures: lock the phone, pull down the notifications. -->
        <service
            android:name=".gesture.LauncherAccessibilityService"
            android:exported="false"
            android:label="@string/gesture_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
        <service
            android:name=".ui.design.WallpaperCapture"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
